{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "lib": [ "DOM", "DOM.Iterable", "ES2022" ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": [ "webpack-env" ],
        "paths": {
            "@/*": [ "src/*" ]
        }
    },
    "include": [ "src", "webpack.config.cjs" ]
}

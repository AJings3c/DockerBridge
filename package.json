{
    "name": "dockerbridge",
    "version": "1.6.0",
    "type": "module",
    "engines": {
        "node": ">= 22.14.0"
    },
    "scripts": {
        "fmt": "eslint \"backend/**/*.ts\" \"common/**/*.ts\" \"extra/test-*.ts\" \"frontend-react/src/**/*.{ts,tsx}\" --fix",
        "lint": "eslint \"backend/**/*.ts\" \"common/**/*.ts\" \"extra/test-*.ts\" \"frontend-react/src/**/*.{ts,tsx}\"",
        "check-ts": "tsc --noEmit && tsc --project ./frontend-react/tsconfig.json",
        "start": "tsx ./backend/index.ts",
        "start:console": "cross-env DOCKERBRIDGE_ENABLE_CONSOLE=true DOCKERBRIDGE_CONSOLE_TARGET=runtime tsx ./backend/index.ts",
        "dev": "concurrently -k -r \"wait-on tcp:5000 && npm run dev:backend \" \"npm run dev:frontend\"",
        "dev:backend": "cross-env NODE_ENV=development DOCKERBRIDGE_ENABLE_CONSOLE=true DOCKERBRIDGE_CONSOLE_TARGET=runtime tsx watch --inspect ./backend/index.ts",
        "dev:frontend": "cross-env NODE_ENV=development webpack serve --config ./frontend-react/webpack.config.cjs --mode development",
        "release-final": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:frontend && npm run build:docker",
        "release-beta": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:frontend && npm run build:docker-beta",
        "build:frontend": "webpack --config ./frontend-react/webpack.config.cjs --mode production",
        "build:docker-base": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/ajings3c/dockerbridge:base -f ./docker/Base.Dockerfile . --push",
        "build:docker": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/ajings3c/dockerbridge:latest -t ghcr.io/ajings3c/dockerbridge:$VERSION --target release -f ./docker/Dockerfile . --push",
        "build:docker-beta": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/ajings3c/dockerbridge:beta -t ghcr.io/ajings3c/dockerbridge:$VERSION --target release -f ./docker/Dockerfile . --push",
        "build:healthcheck": "docker buildx build -f docker/BuildHealthCheck.Dockerfile --platform linux/amd64,linux/arm64 -t ghcr.io/ajings3c/dockerbridge:build-healthcheck . --push",
        "test:system-backup": "tsx ./extra/test-system-backup.ts",
        "test:compose-editor": "tsx ./extra/test-compose-editor.ts",
        "test:docker-resources": "tsx ./extra/test-docker-resources.ts",
        "test:agent-management": "tsx ./extra/test-agent-management.ts",
        "test:user-management": "tsx ./extra/test-user-management.ts",
        "test:security-hardening": "tsx ./extra/test-security-hardening.ts",
        "test:terminal": "tsx ./extra/test-terminal.ts",
        "test": "npm run test:frontend && npm run test:compose-editor && npm run test:docker-resources && npm run test:agent-management && npm run test:user-management && npm run test:system-backup && npm run test:security-hardening && npm run test:terminal",
        "release-nightly": "npm run build:frontend && docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/ajings3c/dockerbridge:nightly --target nightly -f ./docker/Dockerfile . --push",
        "start-docker": "docker run --rm -p 8612:8612 --name dockerbridge -v /var/run/docker.sock:/var/run/docker.sock -v ./data:/app/data -v /opt/stacks:/opt/stacks -e DOCKGE_STACKS_DIR=/opt/stacks -e DOCKERBRIDGE_ENABLE_CONSOLE=true -e DOCKERBRIDGE_CONSOLE_TARGET=runtime ghcr.io/ajings3c/dockerbridge:latest",
        "mark-as-nightly": "tsx ./extra/mark-as-nightly.ts",
        "reformat-changelog": "tsx ./extra/reformat-changelog.ts",
        "reset-password": "tsx ./extra/reset-password.ts",
        "test:frontend": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/archivo": "^5.3.0",
        "@homebridge/node-pty-prebuilt-multiarch": "0.11.14",
        "@louislam/sqlite3": "~15.1.6",
        "bcryptjs": "~2.4.3",
        "check-password-strength": "~2.0.10",
        "command-exists": "~1.2.9",
        "compare-versions": "~6.1.1",
        "composerize": "~1.7.1",
        "croner": "~8.1.2",
        "dayjs": "~1.11.13",
        "dotenv": "~16.3.2",
        "express": "~4.21.2",
        "express-static-gzip": "~2.1.8",
        "http-graceful-shutdown": "~3.1.14",
        "jsonwebtoken": "~9.0.2",
        "jwt-decode": "~3.1.2",
        "knex": "~2.5.1",
        "limiter-es6-compat": "~2.1.2",
        "notp": "^2.0.3",
        "promisify-child-process": "~4.1.2",
        "redbean-node": "~0.3.3",
        "semver": "^7.7.1",
        "socket.io": "~4.8.1",
        "socket.io-client": "~4.8.1",
        "ts-command-line-args": "~2.5.1",
        "tsx": "~4.19.3",
        "type-fest": "~4.3.3",
        "yaml": "~2.3.4"
    },
    "devDependencies": {
        "@actions/github": "^6.0.0",
        "@fontsource/ibm-plex-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@reduxjs/toolkit": "~2.12.0",
        "@tailwindcss/postcss": "~4.3.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/command-exists": "~1.2.3",
        "@types/express": "~4.17.21",
        "@types/jsonwebtoken": "~9.0.9",
        "@types/react": "~19.2.17",
        "@types/react-dom": "~19.2.3",
        "@types/semver": "^7.7.0",
        "@types/webpack-env": "~1.18.8",
        "@typescript-eslint/eslint-plugin": "~6.8.0",
        "@typescript-eslint/parser": "~6.8.0",
        "@xterm/addon-fit": "beta",
        "@xterm/xterm": "beta",
        "autoprefixer": "~10.5.2",
        "compression-webpack-plugin": "~12.0.0",
        "concurrently": "^8.2.2",
        "copy-webpack-plugin": "~14.0.0",
        "cross-env": "~7.0.3",
        "css-loader": "~7.1.4",
        "eslint": "~8.50.0",
        "eslint-plugin-jsdoc": "~46.8.2",
        "html-webpack-plugin": "~5.6.7",
        "lucide-react": "~1.24.0",
        "mini-css-extract-plugin": "~2.10.2",
        "normalize.css": "~8.0.1",
        "postcss": "~8.5.19",
        "postcss-loader": "~8.2.1",
        "react": "~19.2.7",
        "react-dom": "~19.2.7",
        "react-redux": "~9.3.0",
        "react-router-dom": "~7.18.1",
        "style-loader": "~4.0.0",
        "tailwindcss": "~4.3.2",
        "ts-loader": "~9.6.2",
        "typescript": "~5.2.2",
        "vitest": "~3.2.4",
        "wait-on": "^7.2.0",
        "webpack": "~5.108.4",
        "webpack-cli": "~7.2.1",
        "webpack-dev-server": "~6.0.0"
    }
}
